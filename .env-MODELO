# Dados da empresa
COMPRAS_COMPANY_NAME      = Preencha com a sigla e nome da empresa
COMPRAS_DEPARTMENT_NAME   = Preencha com a sigla e nome do departamento
COMPRAS_COORDINATION_NAME = Preencha com a sigla e nome da coordenadoria
COMPRAS_COMPANY_SITE      = Preencha com o site da empresa
COMPRAS_DEPARTMENT_SITE   = Preencha com o site do departamento
COMPRAS_MANUAL_SITE       = Preencha com o link do manual

# Links das planilhas Google
COMPRAS_URL_PLANILHA_CONTROLE = Preencha com o link da planilha de controle de processos (Google Drive)
COMPRAS_url_unidades          = Preencha com o link da planilha de unidades requerentes (Google Drive)
COMPRAS_url_catalogo          = Preencha com o link da planilha do catálogo de materiais (Google Drive)
COMPRAS_url_pa                = Preencha com o link da planilha de processos administrativos e alterações contratuais (Google Drive)
COMPRAS_url_api_catmat        = https://dadosabertos.compras.gov.br/modulo-material/4_consultarItemMaterial?pagina=1&codigoItem=
COMPRAS_url_lista_catmat      = Preencha com o link da lista de CATMATs (Google Drive) - opcional

# URLs das imagens de fundo da Home (separadas por vírgula, sem aspas)
COMPRAS_HOME_BACKGROUND_IMAGES =
# Tempo para substituição automática da imagem de fundo (em segundos)
COMPRAS_HOME_BACKGROUND_REFRESH_TIME = 60

# Pastas dos scripts R
COMPRAS_IMPORTACAO_ARQUIVOS_A_IMPORTAR = ARQUIVOS_IMPORTAR
COMPRAS_IMPORTACAO_RESUMO_PEDIDOS      = RESUMO_PEDIDOS
COMPRAS_IMPORTACAO_RELATORIOS          = RELATORIOS

COMPRAS_ATAS_ATAS  = .
COMPRAS_ATAS_SICAF = SICAF

COMPRAS_CATMAT_TR               = TR
COMPRAS_CATMAT_ARQUIVOS_GERADOS = ARQUIVOS_GERADOS

COMPRAS_MAPAS_MAPAS  = MAPAS
COMPRAS_MAPAS_LISTAS = LISTAS

COMPRAS_FORNECEDORES_DADOS         = DADOS
COMPRAS_FORNECEDORES_PARA_IMPORTAR = PARA_IMPORTAR

# Informações para Power BI
COMPRAS_PLANEJAMENTO_ANO_INICIAL  = 2021
COMPRAS_PROCESSOS_ADM_ANO_INICIAL = 2020

# Interface dos scripts R
# default, mono, invert, matrix, ocean, peach
COMPRAS_SKIN_STYLE = default
# double, heavy, round, square, dotted, bars, default, ascii, minimal, dashed, wavy
COMPRAS_SKIN_BORDER = round
COMPRAS_SKIN_SIZE_MESSAGE = 100
COMPRAS_SKIN_SIZE_PADDING = 1

# Node.js system definitions
COMPRAS_PORT = 3000
COMPRAS_LOG_DIR = logs
COMPRAS_MAX_LOG_FILES = 20
# COMPRAS_LOGGER_MIN_LEVEL: debug, info, warn, error
COMPRAS_LOGGER_MIN_LEVEL = info
# all, error-warning
COMPRAS_LOG_LEVEL = all
